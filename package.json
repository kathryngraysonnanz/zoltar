{
  "name": "epson-tm-m30iii-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web app for printing sample receipts to an Epson TM-m30III over Wi-Fi.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/receipt.js"
  },
  "engines": {
    "node": ">=18"
  }
}