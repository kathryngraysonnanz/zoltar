{
  "name": "epson-tm-m30iii-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web app for printing sample receipts to an Epson TM-m30III over Wi-Fi.",
  "scripts": {
    "start": "npm run build && node src/server.js",
    "dev": "concurrently \"vite\" \"node --watch src/server.js\"",
    "build": "vite build",
    "check": "node --check src/server.js && node --check src/receipt.js && vite build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@progress/kendo-react-progressbars": "^16.0.0",
    "@progress/kendo-theme-default": "^14.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "vite": "^8.2.2"
  }
}
