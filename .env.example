# Firebase project configuration
# Copy this file to .env and fill in your values from the Firebase console.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_ENABLED=true

# Epson TM-m30III ePOS Device Service configuration
VITE_EPSON_PRINTER_TARGET=192.168.192.168
VITE_EPSON_PRINTER_PORT=8008
VITE_EPSON_PRINTER_TARGETS=
VITE_EPSON_PRINTER_PORTS=8008,8043
VITE_EPSON_PRINTER_DEVICE_ID=local_printer
VITE_EPSON_PRINTER_DEVICE_IDS=printer
VITE_EPSON_PRINTER_SERIAL=
VITE_EPSON_PRINTER_CRYPTO=false
VITE_EPSON_PRINTER_BUFFER=true
VITE_EPSON_PRINTER_RESPONSE_TIMEOUT_MS=45000
