# Firebase project configuration
# Copy this file to .env and fill in your values from the Firebase console.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_ENABLED=true

# OpenAI API key, used server-side to generate the printed fortunes.
# If unset, fortunes silently fall back to the built-in static text.
OPENAI_API_KEY=sk-your-openai-key

# KendoReact license key (avoids watermarks / invalid-license banners).
VITE_KENDO_UI_LICENSE=your-kendo-license-key

# Printer network target used by src/server.js.
# Update PRINTER_HOST whenever the printer's IP changes or you move networks.
PRINTER_HOST=192.168.1.123
PRINTER_PORT=9100
EPOS_DEVICE_ID=local_printer
EPOS_TIMEOUT=60000

# Port the Node server listens on.
PORT=3000
